@use '../../../styles/abstracts' as *;

// Space Card Component
.card {
  @include card-base;
  cursor: pointer;
  display: block;
  text-decoration: none;
  color: inherit;

  &:hover {
    @include card-hover;
  }
}

.content {
  @include flex-column;
  height: 100%;
}

.header {
  @include flex-between;
  gap: 1rem;
  margin-bottom: 1rem;
  align-items: center;
}

.icon {
  // Avatar primitive now handles styling
  border-radius: 10px !important; // Override circular default for space icon
}

.titleGroup {
  min-width: 0;
  flex: 1;
}

.title {
  @include truncate(1);
  font-size: 1.125rem;
  font-weight: 600;
  margin: 0;
}

.subtitle {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
}

.description {
  @include truncate(2);
  color: var(--color-text-secondary);
  font-size: 0.9375rem;
  line-height: 1.5;
  margin-bottom: 1rem;
}

.footer {
  @include flex-between;
}

// Badge styling now handled by Badge primitive

.membersSection {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.avatars {
  display: flex;
  align-items: center;
}

.memberAvatar {
  @include avatar(28px);
  border: 2px solid var(--background);
  background: var(--color-bg-tertiary);
  margin-left: -8px;
  transition: all 0.2s ease;
  position: relative;

  &:first-child {
    margin-left: 0;
  }

  &:hover {
    @include hover-lift(0 4px 8px rgba(0, 0, 0, 0.15));
    z-index: 10;

    @include dark-mode {
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);
    }
  }

  @include dark-mode {
    border-color: var(--color-bg-secondary);
  }
}

.memberAvatarImage {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.memberAvatarFallback {
  @include avatar-placeholder(28px, 0.6875rem);
  text-transform: uppercase;

  @include dark-mode {
    background: linear-gradient(135deg, #60a5fa, #3b82f6);
  }
}

.membersCount {
  font-size: 0.8125rem;
  color: var(--color-text-secondary);
  font-weight: 500;
}
